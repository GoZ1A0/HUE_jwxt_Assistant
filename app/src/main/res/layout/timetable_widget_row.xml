<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_card" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
    android:minHeight="52dp" android:orientation="vertical" android:padding="7dp" android:layout_marginEnd="4dp"
    android:background="@drawable/widget_card_blue">
    <TextView android:id="@+id/widget_course" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textSize="14sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end"
        android:textColor="@color/widget_foreground" />
    <TextView android:id="@+id/widget_detail" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:maxLines="1" android:ellipsize="end" android:textSize="11sp" android:textColor="@color/widget_secondary" />
</LinearLayout>
